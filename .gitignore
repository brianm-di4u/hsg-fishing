# Raw geodata downloads (regenerate with: node games/fishing/tools/geo/fetch.mjs)
research/geo/raw/
# Intermediate asset build outputs
art-src/build/
# Raw generated images (packed into assets/pack-*.js by tools/pack-assets.mjs), as with art-src/*.png at the root
art-src/fish/*.png
art-src/scenes/*.png
# Review renders, regenerated by tools/geo/preview.mjs and place.mjs
research/geo/preview-*.png
